# Plantilla de variables de entorno.
# - VITE_SITE_URL va en .env (público, se sube a GitHub).
# - El resto son claves: van en .env.local (NO se sube, *.local está en .gitignore).

# Dominio de la web, sin barra final
VITE_SITE_URL=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# EmailJS (emailjs.com → Email Services / Email Templates / Account)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
